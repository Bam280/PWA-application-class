# Environment Variables Template
# Private REST API configuration for schedules, announcements, reminders, and class roles
VITE_CUSTOM_API_URL=https://api.domain-anda.com/api
VITE_CUSTOM_API_KEY=your_optional_api_key_or_bearer_token

# Optional alias for role management API:
VITE_ROLE_API_URL=https://api.domain-anda.com/api

