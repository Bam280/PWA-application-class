# Environment Variables Template
# No server API keys required for this client application

# Base URL of the role-management API (no trailing slash). Firebase Auth only identifies the
# user; their role comes from GET {VITE_ROLE_API_URL}/me. Contract: docs/ROLE_API.md
# Restart `npm run dev` after changing this value.
VITE_ROLE_API_URL=https://api.example.com/v1
